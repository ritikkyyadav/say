{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "macOSPrivateApi": false
  },
  "bundle": {
    "targets": ["deb", "appimage"],
    "shortDescription": "Local-first dictation",
    "longDescription": "Say is a local-first voice dictation app. Audio stays on your device.",
    "resources": {
      "../../say/dist/linux/SayEngine/": "engine/"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0 | libgtk-3-0t64",
          "libportaudio2",
          "libasound2 | libasound2t64",
          "libasound2-plugins",
          "libxcb-cursor0",
          "libxcb-icccm4",
          "libxcb-keysyms1",
          "libxkbcommon-x11-0",
          "libegl1",
          "libopengl0",
          "libgl1"
        ]
      }
    }
  }
}

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Only ever used to fetch a larger model from download.moonshine.ai on
         request. Dictation itself never touches the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:name=".SayApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Say">

        <activity
            android:name=".ui.HomeActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A see-through activity whose only job is to put the microphone
             prompt up on the IME's behalf: a keyboard has no window of its own
             to ask from. -->
        <activity
            android:name=".ui.MicPermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@style/Theme.Say.Translucent" />

        <!-- Say anywhere: the floating mark over other apps, and the only way to
             type into another app's field without being its keyboard. Enabled by
             the user under Accessibility; reads only the focused field, only
             when a transcript lands in it. -->
        <service
            android:name=".overlay.SayAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- The keyboard. Keyboards with a mic key look for an enabled input
             method whose subtype mode is "voice" (res/xml/method.xml) and
             switch to it; that is how Say is summoned from Gboard, HeliBoard
             and friends, and how it hands the field back afterwards. -->
        <service
            android:name=".ime.SayInputMethodService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>

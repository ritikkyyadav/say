<?xml version="1.0" encoding="utf-8"?>
<!-- The voice panel: the glyph, one status line, done / cancel / back-to-keyboard. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="176dp"
    android:background="@color/say_panel"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageButton
            android:id="@+id/btn_cancel"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_round_ghost"
            android:contentDescription="@string/panel_cancel"
            android:src="@drawable/ic_close" />

        <com.ritikyadav.say.glyph.GlyphView
            android:id="@+id/glyph"
            android:layout_width="228dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:clickable="true"
            android:contentDescription="@string/panel_done"
            android:focusable="true" />

        <Button
            android:id="@+id/btn_allow"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/panel_allow"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_done"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_done"
            android:contentDescription="@string/panel_done"
            android:src="@drawable/ic_check" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="40dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/status"
            style="@style/Say.Text.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/panel_ready" />

        <ImageButton
            android:id="@+id/btn_keyboard"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/panel_keyboard"
            android:src="@drawable/ic_keyboard" />
    </LinearLayout>
</LinearLayout>

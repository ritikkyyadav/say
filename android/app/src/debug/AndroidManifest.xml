<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: a replay hook so a stored dictation can be pushed
     through the whole pipeline on an emulator. Never part of a release. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="com.ritikyadav.say.debug.ReplayReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.ritikyadav.say.DEBUG_REPLAY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
